# ═══════════════════════════════════════════════════════════════════════
# Kalshi BTC Prediction Betting — Environment Configuration
# Copy this file to .env and fill in your credentials
# NEVER commit .env to version control!
# ═══════════════════════════════════════════════════════════════════════

# ──────────────────────────────────────────────────────────────────────
# KALSHI API CREDENTIALS
# Sign up at: https://kalshi.com (live) or https://demo.kalshi.co (demo)
# ──────────────────────────────────────────────────────────────────────
KALSHI_EMAIL=your@email.com
KALSHI_PASSWORD=your_password

# Environment: "demo" (paper trading) or "live" (real money)
KALSHI_ENV=demo

# ──────────────────────────────────────────────────────────────────────
# AUTO-BET CONFIGURATION
# ──────────────────────────────────────────────────────────────────────
# Minimum prediction confidence to place a bet (0.50–0.99)
MIN_CONFIDENCE=0.62

# Maximum dollar amount per single bet
MAX_BET_SIZE=10.0

# Maximum total dollar exposure across all open bets
MAX_EXPOSURE=50.0

# Kelly criterion fraction (0.25 = quarter-Kelly, recommended)
# Higher = more aggressive sizing
KELLY_FRACTION=0.25

# ──────────────────────────────────────────────────────────────────────
# SERVER SETTINGS
# ──────────────────────────────────────────────────────────────────────
HOST=0.0.0.0
PORT=8000

# ──────────────────────────────────────────────────────────────────────
# BITCOIN DATA SOURCE
# Uses Binance public REST API (no key required)
# Symbol: BTCUSDT
# ──────────────────────────────────────────────────────────────────────
BTC_SYMBOL=BTCUSDT
