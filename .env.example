# Futures Trading Agent - Environment Configuration
# Copy this file to .env and fill in your credentials
# NEVER commit .env to version control!

# ============================================
# TRADOVATE API CREDENTIALS (Required for Demo/Live)
# ============================================
# Get these from: https://www.tradovate.com -> Settings -> API Access
TRADOVATE_USERNAME=your_username
TRADOVATE_PASSWORD=your_password
TRADOVATE_CID=your_client_id
TRADOVATE_SEC=your_secret_key
TRADOVATE_DEVICE_ID=optional_device_id

# Environment: demo or live
TRADOVATE_ENV=demo

# ============================================
# NEWS API KEYS (Optional - for sentiment analysis)
# ============================================
# NewsAPI.org - https://newsapi.org/register
NEWSAPI_KEY=your_newsapi_key

# Alpha Vantage - https://www.alphavantage.co/support/#api-key
ALPHAVANTAGE_KEY=your_alphavantage_key

# Finnhub - https://finnhub.io/register
FINNHUB_KEY=your_finnhub_key

# ============================================
# TRADING CONFIGURATION
# ============================================
# Default symbol to trade
DEFAULT_SYMBOL=MESZ4

# Account size for paper trading
PAPER_ACCOUNT_SIZE=50000

# Risk per trade (0.01 = 1%)
RISK_PER_TRADE=0.01

# Update interval in seconds
UPDATE_INTERVAL=60

# ============================================
# MFFU PROP FIRM SETTINGS
# ============================================
# Account tier: Starter, Standard, Premium (or 50K, 100K, 150K)
MFFU_TIER=Starter

# ============================================
# LOGGING CONFIGURATION
# ============================================
# Log level: DEBUG, INFO, WARNING, ERROR
LOG_LEVEL=INFO

# Log directory (relative to project root)
LOG_DIR=logs/app_logs

# ============================================
# GUI SETTINGS
# ============================================
# Theme: dark, light
GUI_THEME=dark

# Auto-refresh interval (ms)
GUI_REFRESH_INTERVAL=1000

# ============================================
# GITHUB SYNC (Optional)
# ============================================
# Enable automatic sync of results to GitHub
GITHUB_SYNC_ENABLED=true

# Branch for results (leave empty for current branch)
GITHUB_RESULTS_BRANCH=
